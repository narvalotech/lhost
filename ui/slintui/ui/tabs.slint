import { Button, VerticalBox, HorizontalBox } from "std-widgets.slint";

export component AppWindow inherits Window {
    // 1. Define your data model
    in property <[string]> tab_names: ["Dashboard", "Analytics", "Settings", "Logs"];
    property <int> active_tab: 0;

    VerticalBox {
        alignment: start;

        // 2. The "Programmatic" Tab Header
        HorizontalBox {
            alignment: start;
            padding: 0;
            spacing: 5px;

            for name[i] in tab_names : Button {
                text: name;
                // Highlight the active tab
                primary: root.active_tab == i;
                clicked => { root.active_tab = i; }
            }
        }

        // 3. Dynamic Content Area
        Rectangle {
            border-radius: 4px;
            min-height: 200px;

            Text {
                text: "Showing content for: " + root.tab_names[root.active_tab];
                color: white;
                font-size: 18px;
            }
        }
    }
}
