import {
    Button,
    StandardTableView,
    StandardButton,
    TextEdit,
    LineEdit,
    TabWidget,
    HorizontalBox,
    VerticalBox
} from "std-widgets.slint";

component ScanResults inherits Rectangle {
    // StandardTableView rows are a model of models (a list of rows, where each row is a list of items)
    in-out property <[[StandardListViewItem]]> device_rows: [];
    in-out property <int> current-row: tv.current-row;
    callback sort-scan-results-cb(int, bool);
    property <length> char-width: 15px;

    min-width: 500px;
    min-height: 200px;
    VerticalLayout {
        tv := StandardTableView {
            sort-ascending(idx) => { sort-scan-results-cb(idx, true); }
            sort-descending(idx) => { sort-scan-results-cb(idx, false); }

            columns: [
                { title: "Address", width: (char-width * 12) },
                { title: "RSSI", width: (char-width * 5) },
                { title: "Name", min-width: (char-width * 5) },
                { title: "Data", min-width: (char-width * 30) },
            ];
            rows: root.device_rows;
        }
    }
}

struct DeviceData {
    address: string,
    conn: int,
    gatt: [[StandardListViewItem]],
}

component GattView inherits Rectangle {
    in property <DeviceData> data;
    callback row-changed(int);
    property <length> char-width: 15px;

    min-width: 500px;
    min-height: 200px;
    VerticalLayout {
        tv := StandardTableView {
            columns: [
                { title: "Handle", width: (char-width * 7) },
                { title: "Type", width: (char-width * 12) },
                { title: "UUID", width: (char-width * 18) },
                { title: "Value" },
            ];
            rows: root.data.gatt;
            current-row-changed(index) => {
                row-changed(index)
            }
        }
    }
}

export enum Command {
    nop,
    start-scan,
    stop-scan,
    clear-scan,
    connect,
    disconnect,
    conn-param-update,
    att-mtu,
    bond,
    clear-bonds,
    stash-bonds,
    unstash-bonds,
    att-read,
    att-write-cmd,
    att-write-req,
    att-read-own,
    att-write-own,
    att-notify,
    data-entry-rsp,
}

export component PopTart inherits Dialog {
    forward-focus: le;
    // bug: the window only auto-sizes on the second show
    max-height: 300px;
    max-width: 400px;

    property <string> placeholder: "Default placeholder";

    // User context
    property <Command> command;
    property <int> conn;
    property <int> handle;

    // Output
    property <string> result <=> le.text;

    // A limitation of current slint:
    // Windows cannot be shown or hidden from slint functions,
    // it has to come from the backend code.
    public function setup-data-entry(
        cmd: Command,
        conn: int,
        handle: int,
        text: string,
        placeholder: string) {
        root.command = cmd;
        root.title = text;
        root.placeholder = placeholder;
        // User context
        // TODO: figure out how to smuggle generic data
        root.conn = conn;
        root.handle = handle;
    }

    callback data-entered(Command, int, int, string);
    function entered(data: string) {
        data-entered(root.command, root.conn, root.handle, data);
    }
    function not-entered() {
        data-entered(Command.nop, root.conn, root.handle, "");
    }

    VerticalBox {
        padding: 10px;
        spacing: 10px;

        le := LineEdit {
            placeholder-text: placeholder;
            key-pressed(event) => {
                if (event.text == Key.Escape) {
                    not-entered();
                    return accept;
                }
                if (event.text == Key.Return) {
                    entered(result);
                    return accept;
                }
                reject
            }
        }
    }

    StandardButton {
        kind: ok;
        primary: true;
        clicked => {
            entered(result);
        }
    }

    StandardButton {
        kind: cancel;
        clicked => {
            not-entered();
        }
    }
}

export struct ScanFilter {
    text: string,
    column: int,
    ascending: bool,
}

struct MenuItemDesc {
    title: string,
    id: Command,
}

struct LazyMenuItem {
    title: string,
    items: [MenuItemDesc],
}

export component AppWindow inherits Window {
    // Define the callback here so Rust can "see" it
    callback button(Command);

    in-out property <string> log-text: "";
    public function log-go-to-bottom() {
        log-viewer.go-to-bottom();
    }
    in-out property <[[StandardListViewItem]]> scan_results_storage;
    in-out property <[[StandardListViewItem]]> scan_results <=> results.device_rows;

    in-out property <DeviceData> gatt_server <=> gatt-server.data;
    in-out property <int> selected_device <=> results.current-row;
    in-out property <[DeviceData]> all-devices: [];
    in-out property <int> active-tab: 0;
    in-out property<bool> scan-focused: true;
    in-out property <ScanFilter> scan-filter: {text: "", column: 1, ascending: false};

    callback filter-scan-results(ScanFilter);
    out property <int> current-att-row;
    out property <string> current-att-handle;

    out property <Command> data-entry-command;
    property <string> data-entry-command-text;
    property <string> data-entry-command-placeholder;
    out property <string> data-entry-user-text;

    property <[MenuItemDesc]> buttons : [
        {title: "Start scan", id: Command.start-scan},
        {title: "Stop scan", id: Command.stop-scan},
        {title: "Connect", id: Command.connect},
        {title: "Bond", id: Command.bond},
        {title: "Disconnect", id: Command.disconnect},

        {title: "ATT Read", id: Command.att-read},
        {title: "ATT Write", id: Command.att-write-req},
        {title: "ATT Write Cmd", id: Command.att-write-cmd},
        {title: "ATT Notify", id: Command.att-notify},
    ];

    property <[LazyMenuItem]> menus : [
        {
            title: "Connection",
            items: [
                {title: "Start scan", id: Command.start-scan},
                {title: "Stop scan", id: Command.stop-scan},
                {title: "Clear scan results", id: Command.clear-scan},
                {title: "Connect", id: Command.connect},
                {title: "Disconnect", id: Command.disconnect},
                {title: "Update conn params", id: Command.conn-param-update},
            ],
        },
        {
            title: "Security",
            items: [
                {title: "Bond / re-encrypt", id: Command.bond},
                {title: "Stash bonds", id: Command.stash-bonds},
                {title: "Unstash bonds", id: Command.unstash-bonds},
                {title: "Delete bonds", id: Command.clear-bonds},
            ],
        },
        {
            title: "GATT Client",
            items: [
                {title: "Read", id: Command.att-read},
                {title: "Write (command)", id: Command.att-write-cmd},
                {title: "Write (request)", id: Command.att-write-req},
                {title: "Exchange MTU", id: Command.att-mtu},
            ],
        },
        {
            title: "GATT Server",
            items: [
                {title: "Notify", id: Command.att-notify},
                {title: "Read own", id: Command.att-read-own},
                {title: "Write own", id: Command.att-write-own},
            ],
        }
    ];

    MenuBar {
        for menu in menus : Menu {
            title: menu.title;
            for item in menu.items: MenuItem {
                title: item.title;
                activated => { button(item.id); }
            }
        }
    }

    VerticalLayout {
        HorizontalLayout {
            VerticalLayout {
                alignment: start;
                padding: 10px;
                spacing: 10px;
                max-width: 100px;
                for button in buttons : Button {
                    text: button.title;
                    clicked => {root.button(button.id);};
                }
            }

            VerticalLayout {
                padding: 10px;
                spacing: 10px;
                property<bool> gatt-server-focused: false;

                VerticalBox {
                    padding: 0px;
                    HorizontalBox {
                        padding: 0px;
                        Button {
                            text: "GATT server";
                            clicked => {
                                root.scan-focused = false;
                                gatt-server-focused = true;
                            }
                        }

                        Button {
                            text: "Scan results";
                            clicked => {
                                root.scan-focused = true;
                                gatt-server-focused = false;
                            }
                        }

                        for device[i] in root.all-devices : Button {
                            text: device.address;
                            clicked => { root.active-tab = i+1; root.scan-focused = false; gatt-server-focused = false; }
                        }
                    }

                    Rectangle {
                        min-height: 600px;
                        min-width: 800px;

                        VerticalBox {
                            visible: root.scan-focused;

                            LineEdit {
                                placeholder-text: "Device filter (name/address)";
                                edited(text) => {
                                    root.scan-filter.text = text;
                                    root.filter-scan-results(scan-filter);
                                }
                            }

                            Rectangle {
                                results := ScanResults {
                                    sort-scan-results-cb(idx, asc) => {
                                        root.scan-filter.column = idx;
                                        root.scan-filter.ascending = asc;
                                        root.filter-scan-results(scan-filter);
                                    }
                                }
                            }
                        }

                        gatt-server := GattView {
                            visible: gatt-server-focused;
                            row-changed(index) => {
                                root.current-att-row = index;
                                root.current-att-handle = self.data.gatt[index][0].text;
                            }
                        }

                        for device[i] in root.all-devices : GattView {
                            data: device;
                            visible: (root.active-tab == i+1) && !root.scan-focused && !gatt-server-focused;
                            row-changed(index) => {
                                root.current-att-row = index;
                                root.current-att-handle = device.gatt[index][0].text;
                            }
                        }
                    }
                }

                log-viewer:= TextEdit {
                    min-height: 100px;
                    read-only: true;
                    wrap: no-wrap;
                    text: root.log-text;
                    function go-to-bottom() {
                        self.viewport-y = min(0px, - self.viewport-height + self.visible-height);
                    }
                }
            }
        }
    }
}
